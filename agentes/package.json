{
    "name": "agentes",
    "version": "1.0.0",
    "private": true,
    "description": "Agentes con anthropic SDK",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || ^22.13.0 || >=24.11.0"
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck:test": "tsc -p tsconfig.test.json",
        "start": "node dist/src/server.js",
        "dev": "tsx src/server.ts",
        "test": "vitest run",
        "test:watch": "vitest",
        "migration:run": "tsx src/infra/data-source.ts"
    },
    "dependencies": {
        "@anthropic-ai/claude-agent-sdk": "^0.3.332"
    },
    "devDependencies": {
        "@types/node": "^26.6.7",
        "typescript": "^7.0.2"
    }
}
